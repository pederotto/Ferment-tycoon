{
  "name": "fermenta-tycoon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "package": "vite build && python3 scripts/package_artifact.py",
    "i18n:check": "node scripts/i18n/check.cjs",
    "i18n:test": "esbuild scripts/i18n/engine.test.ts --bundle --platform=node --outfile=/tmp/i18n-engine-test.cjs --log-level=error && node /tmp/i18n-engine-test.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.561.0",
    "react-dom": "^19.2.3",
    "react": "^19.2.3",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "description": "A culinary fermentation tycoon sim \u2014 koji, garums and misos, simulated properly."
}
